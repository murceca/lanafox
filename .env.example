# Public Cloudinary delivery cloud name (required when PHOTO_SOURCE is snapshot or cloudinary)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# Gallery photo source for builds: fixture | snapshot | cloudinary
PHOTO_SOURCE=snapshot

# Public canonical HTTPS origin
SITE_ORIGIN=https://lanafox.eu

# API base URL (defaults to http://localhost:7071 in local dev/preview; https://api.lanafox.eu in production)
NEXT_PUBLIC_API_BASE_URL=http://localhost:7071

# Build-only Cloudinary Admin API credentials (only required when PHOTO_SOURCE=cloudinary; never expose to client)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@your-cloudinary-cloud-name

# Azure Functions v4 production runtime settings (configured as Function App Settings in Azure; not used in local mock mode)
# TABLE_ENDPOINT=https://lanafoxproduction.table.core.windows.net/
# API_STATE_TABLE=ApiState
# EMAIL_ENDPOINT=https://lanafox-production-communication.europe.communication.azure.com
# EMAIL_SENDER=DoNotReply@lanafox.eu
# EMAIL_RECIPIENT=contact@lanafox.eu
# ALLOWED_ORIGINS=https://lanafox.eu
# API_HASH_SECRET=generate-with-openssl-rand-hex-32
