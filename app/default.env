# Application Environment & Server Settings
NODE_ENV=development
PORT=3000

# Cloudinary Integration (used by utils/image.js for portfolio photo gallery)
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz01234@dummy-cloud-name

# SMTP / Email Settings (used by utils/email.js for contact form notifications)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_ACCOUNT_LOGIN=user@example.com
SMTP_ACCOUNT_PASSWORD=your-smtp-password

